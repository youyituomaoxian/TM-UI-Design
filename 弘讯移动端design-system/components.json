      "referenceCss": ".mbtn{display:inline-flex;align-items:center;justify-content:center;border:none;font-family:var(--font-cn);font-weight:500;cursor:pointer;border-radius:var(--radius-md)}.mbtn-lg{height:48px;min-width:120px;padding:0 16px;font-size:16px}.mbtn-md{height:40px;min-width:80px;padding:0 16px;font-size:14px}.mbtn-sm{height:32px;min-width:64px;padding:0 16px;font-size:12px;font-weight:400}.mbtn-login{height:56px;min-width:300px;font-size:16px;font-weight:500}.mbtn-primary{background:var(--primary);color:var(--n1)}.mbtn-primary:active{background:var(--primary-active)}.mbtn-secondary{background:var(--n1);color:var(--primary);border:1px solid var(--primary)}.mbtn:disabled{background:var(--primary-dis-bg);color:var(--primary-dis-fg)}.ios .mbtn{border-radius:var(--radius-btn-ios)}",
      "referenceHtml": "<button class=\"mbtn mbtn-lg mbtn-primary\">主操作</button><button class=\"mbtn mbtn-md mbtn-secondary\">次操作</button>",
      "ardot": {

      "referenceCss": ".bottomnav{width:375px;background:var(--n1);box-shadow:var(--shadow-bottom-nav);display:flex}.bottomnav-android{height:56px}.bottomnav-ios{height:83px}.bn-item{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px}.bn-icon{width:24px;height:24px;color:var(--n7)}.bn-label{font-size:12px;color:var(--n7);font-family:var(--font-cn)}.bn-item.active .bn-icon,.bn-item.active .bn-label{color:var(--primary)}",
      "referenceHtml": "<div class=\"bottomnav bottomnav-android\"><div class=\"bn-item active\"><span class=\"bn-icon\">▣</span><span class=\"bn-label\">监控</span></div><div class=\"bn-item\"><span class=\"bn-icon\">▤</span><span class=\"bn-label\">参数</span></div></div>",
      "ardot": {
        "libraryComponent": "底部导航（Ardot 移动端组件库）",
        "variantMapping": "bn-item 对应 Ardot 底部导航元素（是否有文字 × 选中，共 4 变体）；bn-item.active 对应 选中=是 格（图标+文字=主色 #005EAE）。",
        "notes": "Android 56 / iOS 83（含 34 安全区）。N1 底、未激活 N7、激活 primary。最多 5 项。勿在底栏用主色背景（主色留给顶部导航）。"
      },
      "do": [
        "Android 56 / iOS 83",
        "N1 底 + N7 未激活 + primary 激活",
        "底部投影 bottom-nav"
      ],
      "dont": [
        "底栏用主色背景",
        "高度跨平台混用",
        "单项用非 primary 激活色"
      ]
    },
